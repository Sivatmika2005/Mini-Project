# Firebase Configuration
FIREBASE_KEY_PATH=firebase-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Application URLs
APP_URL=http://localhost:8501
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

# ==============================================================================
# External AI API Configuration (Choose your provider)
# ==============================================================================
# Primary Provider: Google Gemini API (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# Alternative Provider: Groq Cloud API (Get free fast inference key from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Provider: OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Location & Places Configuration
# ==============================================================================
# Optional: Google Maps & Places API key for dynamic nearby searches and reverse geocoding
# If omitted, system seamlessly uses our audited verified medical directory of 78+ establishments
# covering 16 Tamil Nadu cities and 22 major Indian cities with exact Haversine distance calculations.
GOOGLE_MAPS_API_KEY=
